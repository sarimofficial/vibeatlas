# VibeAtlas environment variables — server-side only, never commit real values.
# Hackathon host (REQUIRED for hackathon keys): hackathon keys work ONLY here.
# They do NOT work against https://api.qloo.com (production) — that host returns 401 for hackathon keys.
# If your key was issued for a different host, put that host here instead.
QLOO_API_BASE_URL=https://hackathon.api.qloo.com
# Your own Qloo API key, from the hackathon API key request form (see README).
# No key is required to run the app: without it, the app runs in labelled demo mode.
QLOO_API_KEY=
